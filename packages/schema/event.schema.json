{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tm1944/hypothesis-globe/packages/schema/event.schema.json",
  "title": "Event",
  "description": "Shared Event contract. Field names are stable. Do not rename in the API or UI.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "source",
    "links",
    "layerId",
    "title",
    "summary",
    "occurredAt",
    "updatedAt",
    "lng",
    "lat",
    "altM",
    "geoPrecision",
    "geoSource",
    "weight",
    "significance",
    "entities",
    "rawRef"
  ],
  "properties": {
    "id": { "type": "string" },
    "source": { "type": "string" },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "source"],
        "properties": {
          "url": { "type": "string", "format": "uri" },
          "source": { "type": "string" },
          "label": { "type": "string" }
        }
      },
      "description": "One or more source URLs for this event. Multiple entries when deduplication merges events from different sources."
    },
    "canonicalId": {
      "type": "string",
      "description": "Set on duplicate events to point to the canonical event id that supersedes this one."
    },
    "layerId": {
      "type": "string",
      "enum": [
        "earthquake",
        "wildfire",
        "conflict",
        "politics",
        "terror",
        "finance",
        "humanitarian",
        "news",
        "world",
        "business",
        "technology",
        "science",
        "health",
        "environment",
        "crime",
        "sports",
        "entertainment",
        "culture",
        "fashion",
        "travel",
        "food",
        "education",
        "media",
        "cyclone",
        "flood",
        "volcano",
        "drought",
        "famine",
        "protest",
        "strategic_development"
      ]
    },
    "subtype": { "type": ["string", "null"] },
    "tags": { "type": "array", "items": { "type": "string" } },
    "attributes": { "type": "object" },
    "title": { "type": "string" },
    "summary": { "type": ["string", "null"] },
    "occurredAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "lng": { "type": ["number", "null"], "minimum": -180, "maximum": 180 },
    "lat": { "type": ["number", "null"], "minimum": -90, "maximum": 90 },
    "altM": { "type": ["number", "null"] },
    "geoPrecision": {
      "type": ["string", "null"],
      "enum": ["point", "city", "region", "country", null]
    },
    "geoSource": {
      "type": "string",
      "enum": ["native", "google_geocode", "google_places", "centroid", "llm_hint"]
    },
    "weight": { "type": "number" },
    "significance": { "type": "number" },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "text", "confidence"],
        "properties": {
          "type": { "type": "string" },
          "text": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "rawRef": { "type": ["string", "null"] }
  }
}
