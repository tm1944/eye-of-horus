{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tm1944/hypothesis-globe/packages/schema/event.schema.json",
  "title": "Event",
  "description": "Shared Event contract. Field names are stable. Do not rename in the API or UI.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "source",
    "sourceUrl",
    "layerId",
    "title",
    "summary",
    "occurredAt",
    "updatedAt",
    "lng",
    "lat",
    "altM",
    "geoPrecision",
    "geoSource",
    "weight",
    "significance",
    "entities",
    "rawRef"
  ],
  "properties": {
    "id": { "type": "string" },
    "source": { "type": "string" },
    "sourceUrl": { "type": ["string", "null"], "format": "uri" },
    "layerId": {
      "type": "string",
      "enum": [
        "earthquake",
        "wildfire",
        "conflict",
        "politics",
        "terror",
        "finance",
        "humanitarian",
        "news"
      ]
    },
    "title": { "type": "string" },
    "summary": { "type": ["string", "null"] },
    "occurredAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "lng": { "type": "number", "minimum": -180, "maximum": 180 },
    "lat": { "type": "number", "minimum": -90, "maximum": 90 },
    "altM": { "type": ["number", "null"] },
    "geoPrecision": {
      "type": "string",
      "enum": ["point", "city", "region", "country"]
    },
    "geoSource": {
      "type": "string",
      "enum": ["native", "google_geocode", "google_places", "centroid", "llm_hint"]
    },
    "weight": { "type": "number" },
    "significance": { "type": "number" },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "text", "confidence"],
        "properties": {
          "type": { "type": "string" },
          "text": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "rawRef": { "type": ["string", "null"] }
  }
}
