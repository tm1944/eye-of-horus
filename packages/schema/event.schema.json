{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tm1944/hypothesis-globe/packages/schema/event.schema.json",
  "title": "Event",
  "description": "Shared Event contract. Mirrors the TigerData mart.event table (the source of truth); apps/api/db.py maps each column to the camelCase field noted below. Change the table first, then this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "source",
    "sourceUrl",
    "imageUrl",
    "layerId",
    "subtype",
    "title",
    "summary",
    "occurredAt",
    "updatedAt",
    "endedAt",
    "lng",
    "lat",
    "altM",
    "geoPrecision",
    "geoSource",
    "weight",
    "significance",
    "countryIso3",
    "keywords",
    "entities",
    "rawRef",
    "tags",
    "attributes"
  ],
  "$defs": {
    "term": {
      "type": "object",
      "required": ["text", "type"],
      "properties": {
        "text": { "type": "string" },
        "type": { "type": "string" },
        "relevance": { "type": "number", "minimum": 0, "maximum": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  },
  "properties": {
    "id": { "type": "string", "description": "event_id, e.g. usgs:us7000abcd" },
    "source": { "type": "string", "description": "source, e.g. usgs, firms, gdacs, gnews, wikifeeds, conflict_csv" },
    "sourceUrl": { "type": ["string", "null"], "description": "info_url" },
    "imageUrl": { "type": ["string", "null"], "description": "image_url: article thumbnail, loaded directly from the publisher" },
    "layerId": {
      "type": "string",
      "description": "category",
      "enum": [
        "earthquake",
        "wildfire",
        "conflict",
        "politics",
        "terror",
        "finance",
        "humanitarian",
        "news",
        "world",
        "business",
        "technology",
        "science",
        "health",
        "environment",
        "crime",
        "sports",
        "entertainment",
        "culture",
        "fashion",
        "travel",
        "food",
        "education",
        "media",
        "cyclone",
        "flood",
        "volcano",
        "drought",
        "famine",
        "protest",
        "strategic_development"
      ]
    },
    "subtype": { "type": ["string", "null"] },
    "title": { "type": "string" },
    "summary": { "type": ["string", "null"] },
    "occurredAt": { "type": "string", "format": "date-time", "description": "occurred_at" },
    "updatedAt": { "type": "string", "format": "date-time", "description": "updated_at, or occurred_at when updated_at is null" },
    "endedAt": { "type": ["string", "null"], "format": "date-time", "description": "ended_at" },
    "lng": { "type": "number", "minimum": -180, "maximum": 180 },
    "lat": { "type": "number", "minimum": -90, "maximum": 90 },
    "altM": { "type": ["number", "null"], "description": "alt_m" },
    "geoPrecision": { "type": "string", "description": "geo_precision, e.g. point, city, region, country, continent" },
    "geoSource": { "type": "string", "description": "geo_source, e.g. native, gemini" },
    "weight": { "type": ["number", "null"], "description": "Source-specific magnitude (FRP, alert score, fatalities); null for news" },
    "significance": { "type": "number" },
    "countryIso3": { "type": ["string", "null"], "description": "country_iso3" },
    "keywords": {
      "type": "array",
      "items": { "$ref": "#/$defs/term" },
      "description": "AI-extracted keywords (news, USGS)"
    },
    "entities": {
      "type": "array",
      "items": { "$ref": "#/$defs/term" },
      "description": "Named actors and places (conflict data)"
    },
    "rawRef": { "type": ["string", "null"], "description": "raw_ref" },
    "tags": { "type": "array", "items": { "type": "string" }, "description": "mart.event_tag rows" },
    "attributes": { "type": "object", "description": "Category table row (mart.earthquake, mart.wildfire, ...)" }
  }
}
