# Paste values into .env (gitignored). Leave a line blank to skip that integration.
# DATABASE_URL: from `tiger db uri --with-password` or the Tiger console service URL.
# FIRMS_MAP_KEY: https://firms.modaps.eosdis.nasa.gov/api/map_key/
DATABASE_URL=
FIRMS_MAP_KEY=

# Required only to authorize POST /ingest/run.
INGEST_SECRET=
# Optional override; defaults to the bundled jobs.ingest module with DATABASE_URL set.
INGEST_COMMAND=
INGEST_TIMEOUT_SECONDS=60
