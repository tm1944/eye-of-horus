# Copy to .env.local; use only server-side values. Never commit .env.local.
# Leave DATABASE_URL empty for fixtures. Copy the real URI from TigerData.
DATABASE_URL=
FIRMS_MAP_KEY=
INGEST_SECRET=
# JSON array of Track B's executable and arguments, once its loader is ready.
INGEST_COMMAND=
INGEST_TIMEOUT_SECONDS=60
